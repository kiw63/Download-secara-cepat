name = "blink-api"
main = "worker.js"
compatibility_date = "2026-10-01"

# Copy to wrangler.toml and replace database_id after creating D1.
# Do not commit API tokens or secrets.
[[d1_databases]]
binding = "DB"
database_name = "blink-db"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Add an R2 bucket binding only after creating the bucket:
# [[r2_buckets]]
# binding = "VIDEOS"
# bucket_name = "blink-videos"

[vars]
APP_ORIGIN = "https://YOUR-USERNAME.github.io"
